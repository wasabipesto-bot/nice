+    /// candidates. The same fields then run as before.
+    fn check_skipped_entries<R: Runtime>(client: &ComputeClient<R>, name: &str) {
+        let skip = |on: bool| SKIP_FIRST.with(|c| c.set(on));
+        let lim = device_limits(client, name);
+        let w = WINDOWS[0];
+        for (b, s, e, jp) in [
