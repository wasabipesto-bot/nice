diff --git a/common/examples/l42_fdbench.rs b/common/examples/l42_fdbench.rs
new file mode 100644
index 00000000..be276ec7
--- /dev/null
+++ b/common/examples/l42_fdbench.rs
@@ -0,0 +1,219 @@
+//! L42 scratch harness (not for a PR): the FD top certificate against
+//! `Base::cert` on a field's real top-layer prefixes, for exactness and
+//! time per certificate.
+//!
+//! usage: l42_fdbench <base> <start> <size> <mode: part|key> <sample> [batch] [slice]
+//!   part: consecutive partitions v0..v0+batch of every `sample`-th prefix (step h = 1)
+//!   key:  every key's prefixes in layer order, in `sample` partitions (step h = b^(p+1)),
+//!         stepping over gaps of up to `batch` (else seeding)
+use nice_common::FieldSize;
+use nice_common::cpu_join::{CpuJoin, slices_for};
+use nice_common::l42_fd::{Mg, TopFd, TopFdSetup, cert_df};
+use std::hint::black_box;
+use std::time::Instant;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let base: u32 = a[1].parse().unwrap();
+    let start: u128 = a[2].parse().unwrap();
+    let size: u128 = a[3].parse::<f64>().unwrap() as u128;
+    let mode = a[4].as_str();
+    let sample: usize = a[5].parse().unwrap();
+    let batch: u32 = a.get(6).map_or(8, |s| s.parse().unwrap());
+    let si: usize = a.get(7).map_or(0, |s| s.parse().unwrap());
+    let range = FieldSize::new(start, start + size);
+    let (jp, slices) = slices_for(base, &range).expect("a join field");
+    let join = CpuJoin::new(base, &slices[si], jp).expect("setup");
+    let fs = join.l42_fs();
+    let bs = &fs.base;
+    let k = jp.k;
+    let t = fs.base.l - fs.f0;
+    let nparts = fs.nparts;
+    let w = fs.w;
+    // Slots: (P) in the order the variant visits them; `step[i]` = how many
+    // h-steps from the previous slot (0 = seed).
+    let mut slots: Vec<(u128, u32)> = Vec::new();
+    let s_exp = match mode {
+        "part" => 0,
+        "key" => jp.p + 1,
+        _ => panic!("mode"),
+    };
+    let unclipped = |p: u128| {
+        p >= fs.plo && p <= fs.phi && p * w >= fs.s && p * w + w - 1 <= fs.e - 1
+    };
+    match mode {
+        "part" => {
+            let parts = nparts as u32;
+            let mut i = 0usize;
+            while i < fs.tlay.len() {
+                let p0 = fs.tlay[i].0;
+                let v0 = (i as u32 * 7919) % parts.saturating_sub(batch).max(1);
+                let mut prev: Option<u128> = None;
+                for v in v0..(v0 + batch).min(parts) {
+                    let p = p0 * nparts + u128::from(v);
+                    if !unclipped(p) {
+                        prev = None;
+                        continue;
+                    }
+                    let st = match prev {
+                        Some(q) if q + 1 == p => 1,
+                        _ => 0,
+                    };
+                    slots.push((p, st));
+                    prev = Some(p);
+                }
+                i += sample;
+            }
+        }
+        _ => {
+            let key_off = join.l42_key_off();
+            let parts = nparts as u32;
+            let h = nparts * u128::from(base);
+            for n in 0..sample {
+                let v = (n as u32 * 997 + 13) % parts;
+                for key in 0..key_off.len() - 1 {
+                    let mut prev: Option<u128> = None;
+                    for &(p0, _) in &fs.tlay[key_off[key] as usize..key_off[key + 1] as usize] {
+                        let p = p0 * nparts + u128::from(v);
+                        if !unclipped(p) {
+                            prev = None;
+                            continue;
+                        }
+                        let st = match prev {
+                            Some(q) if p > q && (p - q) % h == 0 && (p - q) / h <= u128::from(batch) => {
+                                ((p - q) / h) as u32
+                            }
+                            _ => 0,
+                        };
+                        slots.push((p, st));
+                        prev = Some(p);
+                    }
+                }
+            }
+        }
+    }
+    let seeds = slots.iter().filter(|s| s.1 == 0).count();
+    let steps: u64 = slots.iter().map(|s| u64::from(s.1)).sum();
+    let mut gap_hist = [0usize; 9];
+    for s in &slots {
+        gap_hist[(s.1 as usize).min(8)] += 1;
+    }
+    let mut setup = TopFdSetup::new(bs, fs.f0, t, s_exp, k);
+    let mg = Mg::new(u64::from(base));
+    println!(
+        "b{base} [{start}, +{size:e}) {jp:?} slice {si}/{}: mode {mode}, {} slots, {} seeds ({:.1}%), {} steps ({:.2} per slot); step-count hist {:?}",
+        slices.len(),
+        slots.len(),
+        seeds,
+        100.0 * seeds as f64 / slots.len() as f64,
+        steps,
+        steps as f64 / slots.len() as f64,
+        gap_hist
+    );
+    // Exactness.
+    let mut st: Option<TopFd> = None;
+    let mut kept = 0usize;
+    for &(p, n) in &slots {
+        let a0 = p * w;
+        let want = bs.cert(a0, a0 + w - 1, k);
+        let s = if n == 0 {
+            st.insert(setup.seed(bs, p))
+        } else {
+            let s = st.as_mut().unwrap();
+            for _ in 0..n {
+                setup.step(s);
+            }
+            s
+        };
+        assert_eq!(s.p, p);
+        let got = setup.cert(bs, s);
+        assert_eq!(got, want, "P = {p}");
+        assert_eq!(cert_df(bs, mg, a0, a0 + w - 1, k), want, "DF P = {p}");
+        kept += usize::from(want.is_some());
+    }
+    println!("exact: {} slots agree ({} kept, {:.1}%)", slots.len(), kept, 100.0 * kept as f64 / slots.len() as f64);
+    // Timing, 3 rounds each, alternating.
+    for round in 0..3 {
+        let t0 = Instant::now();
+        let mut acc = 0u64;
+        for &(p, _) in &slots {
+            let a0 = p * w;
+            acc ^= bs.cert(black_box(a0), a0 + w - 1, k).unwrap_or(1);
+        }
+        let t_ref = t0.elapsed().as_secs_f64();
+        black_box(acc);
+        let mut t_fds = [0f64; 3];
+        for (vi, (fc, dfs)) in [(false, false), (true, false), (true, true)].into_iter().enumerate() {
+            setup.fast_carry = fc;
+            setup.df_seed = dfs;
+            let t0 = Instant::now();
+            let mut acc = 0u64;
+            let mut st: Option<TopFd> = None;
+            for &(p, n) in &slots {
+                let s = if n == 0 {
+                    st.insert(setup.seed(bs, black_box(p)))
+                } else {
+                    let s = st.as_mut().unwrap();
+                    for _ in 0..n {
+                        setup.step(s);
+                    }
+                    s
+                };
+                acc ^= setup.cert(bs, s).unwrap_or(1);
+            }
+            t_fds[vi] = t0.elapsed().as_secs_f64();
+            black_box(acc);
+        }
+        let t_fd = t_fds[2];
+        let t0 = Instant::now();
+        let mut acc = 0u64;
+        for &(p, _) in &slots {
+            let a0 = p * w;
+            acc ^= cert_df(bs, mg, black_box(a0), a0 + w - 1, k).unwrap_or(1);
+        }
+        let t_df = t0.elapsed().as_secs_f64();
+        black_box(acc);
+        // Seed-only and step-only costs.
+        let t0 = Instant::now();
+        let mut acc = 0u64;
+        for &(p, _) in slots.iter().take(slots.len() / 4) {
+            let s = setup.seed(bs, black_box(p));
+            acc ^= s.p as u64;
+        }
+        let t_seed = t0.elapsed().as_secs_f64() / (slots.len() / 4) as f64;
+        black_box(acc);
+        let n = slots.len() as f64;
+        println!(
+            "round {round}: Base::cert {:.1} ns/slot, DF {:.1} (x{:.2}), FD plain {:.1} (x{:.2}), +screen {:.1} (x{:.2}), +DF seed {:.1} ns/slot (x{:.2}); DF seed alone {:.1} ns",
+            t_ref / n * 1e9,
+            t_df / n * 1e9,
+            t_ref / t_df,
+            t_fds[0] / n * 1e9,
+            t_ref / t_fds[0],
+            t_fds[1] / n * 1e9,
+            t_ref / t_fds[1],
+            t_fd / n * 1e9,
+            t_ref / t_fd,
+            t_seed * 1e9
+        );
+    }
+    // Stepped-only cost: certificates of stepped slots, state stepped.
+    let stepped: Vec<_> = slots.iter().filter(|s| s.1 > 0).collect();
+    if !stepped.is_empty() {
+        let mut st = setup.seed(bs, slots[0].0);
+        let t0 = Instant::now();
+        let mut acc = 0u64;
+        for _ in 0..stepped.len() {
+            setup.step(&mut st);
+            acc ^= setup.cert(bs, black_box(&st)).unwrap_or(1);
+            if st.p > fs.phi.saturating_sub(4 * u128::from(base).pow(4)) {
+                st = setup.seed(bs, slots[0].0);
+            }
+        }
+        black_box(acc);
+        println!(
+            "pure step+cert (one prefix run): {:.1} ns/slot",
+            t0.elapsed().as_secs_f64() / stepped.len() as f64 * 1e9
+        );
+    }
+}
diff --git a/common/examples/l42_prof.rs b/common/examples/l42_prof.rs
new file mode 100644
index 00000000..e2ae804b
--- /dev/null
+++ b/common/examples/l42_prof.rs
@@ -0,0 +1,135 @@
+//! L42 scratch harness (not for a PR): run sampled partitions of one slice
+//! of a nice-only field through the CPU join and print the wall time and,
+//! with `--features l42-prof`, the per-phase TSC split.
+//!
+//! usage: l42_prof <base> <start> <size> <threads> <partitions|0=all> [slice]
+use nice_common::FieldSize;
+use nice_common::bench_defs::sample_order;
+use nice_common::cpu_join::{CpuJoin, PartitionResult, Scratch, slices_for};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Instant;
+
+fn tsc() -> u64 {
+    // SAFETY: no preconditions.
+    unsafe { core::arch::x86_64::_rdtsc() }
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let base: u32 = a[1].parse().unwrap();
+    let start: u128 = a[2].parse().unwrap();
+    let size: u128 = a[3].parse::<f64>().map(|x| x as u128).unwrap_or_else(|_| a[3].parse().unwrap());
+    let threads: usize = a[4].parse().unwrap();
+    let want: usize = a[5].parse().unwrap();
+    let si: usize = a.get(6).map_or(0, |s| s.parse().unwrap());
+    let range = FieldSize::new(start, start + size);
+    let (jp, slices) = slices_for(base, &range).expect("a join field");
+    let t = Instant::now();
+    let join = CpuJoin::new(base, &slices[si], jp).expect("setup");
+    let setup = t.elapsed().as_secs_f64();
+    let (tlay, bpre, roots, keyspace, mid, k2, ff) = join.l42_shape();
+    let parts = join.partitions();
+    let order = sample_order(parts);
+    let n = if want == 0 { order.len() } else { want.min(order.len()) };
+    println!(
+        "b{base} [{start}, +{size:e}) {jp:?}: {} slices, slice {si} = [{}, +{:e}); setup {setup:.3}s; \
+         tlay {tlay} prefixes, bpre {bpre}, roots {roots}, keyspace {keyspace}, mid {mid}, k2 {k2}, full_floor {ff}; \
+         {parts} partitions, running {n} on {threads} thread(s)",
+        slices.len(),
+        slices[si].start(),
+        slices[si].size() as f64,
+    );
+    let next = AtomicUsize::new(0);
+    let t0 = tsc();
+    let wall = Instant::now();
+    let (out, cyc_total) = std::thread::scope(|s| {
+        let ws: Vec<_> = (0..threads)
+            .map(|_| {
+                s.spawn(|| {
+                    let mut sc = Scratch::default();
+                    let mut out = PartitionResult::default();
+                    let mut cyc = 0u64;
+                    loop {
+                        let i = next.fetch_add(1, Ordering::Relaxed);
+                        if i >= n {
+                            return (out, cyc);
+                        }
+                        let c0 = tsc();
+                        out.add(join.run_partition(order[i], &mut sc));
+                        cyc += tsc() - c0;
+                    }
+                })
+            })
+            .collect();
+        let mut out = PartitionResult::default();
+        let mut cyc = 0u64;
+        for w in ws {
+            let (o, c) = w.join().unwrap();
+            out.add(o);
+            cyc += c;
+        }
+        (out, cyc)
+    });
+    let secs = wall.elapsed().as_secs_f64();
+    let tsc_hz = (tsc() - t0) as f64 / secs;
+    let per = secs * threads as f64 / n as f64;
+    let field_1t = per * f64::from(parts);
+    println!(
+        "wall {secs:.3}s; {:.2} ms/partition/thread; slice on {threads} thread(s) ~{:.1}s (+setup); \
+         survivors {} checked {} hits {}; tsc {:.3} GHz",
+        per * 1e3,
+        field_1t / threads as f64,
+        out.survivors,
+        out.checked,
+        out.hits.len(),
+        tsc_hz / 1e9
+    );
+    let p = &out.prof;
+    if p.cyc.iter().all(|&c| c == 0) {
+        return;
+    }
+    let tot = cyc_total as f64;
+    let pc = |c: u64| 100.0 * c as f64 / tot;
+    let scan_pure = p.cyc[4] - p.cyc[5];
+    let surv_other = p.cyc[5] - p.cyc[6] - p.cyc[7];
+    let other = cyc_total - p.cyc[0] - p.cyc[1] - p.cyc[2] - p.cyc[3] - p.cyc[4];
+    println!("phase split (% of partition cycles, summed over threads):");
+    println!("  tops (cert)        {:6.2}%", pc(p.cyc[0]));
+    println!("  extend (bottoms)   {:6.2}%", pc(p.cyc[1]));
+    println!("  advance+list       {:6.2}%", pc(p.cyc[2]));
+    println!("  sort tops          {:6.2}%", pc(p.cyc[3]));
+    if p.cyc[5] == 0 {
+        println!("  scan incl. surv.   {:6.2}%", pc(p.cyc[4]));
+    } else {
+        println!("  AND scan (pure)    {:6.2}%", pc(scan_pure));
+        println!("  survivor prefilter {:6.2}%  (incl. in-range test)", pc(p.cyc[7]));
+        println!("  survivor full chk  {:6.2}%", pc(p.cyc[6]));
+        let _ = surv_other;
+    }
+    println!("  other (loop etc.)  {:6.2}%", pc(other));
+    let nn = n as f64;
+    println!(
+        "per partition: layer {:.0} cert-pass {:.0} clipped {:.1} | ext {:.0} listed {:.0} keys {:.1} | ANDs {:.3e} pass {:.0} out-of-range {:.0} | survivors {:.0} checked {:.2}",
+        p.layer as f64 / nn,
+        p.cert_some as f64 / nn,
+        p.clipped as f64 / nn,
+        p.ext as f64 / nn,
+        p.listed as f64 / nn,
+        p.keys as f64 / nn,
+        p.ands as f64 / nn,
+        p.and_pass as f64 / nn,
+        p.out_of_range as f64 / nn,
+        out.survivors as f64 / nn,
+        out.checked as f64 / nn,
+    );
+    println!(
+        "unit costs (cycles; scan ones need l42-prof-surv): tops/visited {:.0}, extend/bpre {:.1}, list/listed {:.2}, AND/bottom {:.3}, survivor/pass {:.0}, prefilter/pass {:.0}, full/checked {:.0}",
+        p.cyc[0] as f64 / p.layer.max(1) as f64,
+        p.cyc[1] as f64 / p.ext.max(1) as f64,
+        p.cyc[2] as f64 / p.listed.max(1) as f64,
+        scan_pure as f64 / p.ands.max(1) as f64,
+        p.cyc[5] as f64 / p.and_pass.max(1) as f64,
+        p.cyc[7] as f64 / p.and_pass.max(1) as f64,
+        p.cyc[6] as f64 / out.checked.max(1) as f64,
+    );
+}
diff --git a/common/src/cpu_join.rs b/common/src/cpu_join.rs
index 6853beb6..97fa770f 100644
--- a/common/src/cpu_join.rs
+++ b/common/src/cpu_join.rs
@@ -54,6 +54,76 @@ pub fn slices_for(base: u32, range: &FieldSize) -> Option<(JoinParams, Vec<Field
 /// The mask of a bottom whose fixed digits repeat: it joins no top.
 const DEAD: u64 = u64::MAX;
 
+/// L42 scratch: per-phase TSC cycles and counts (feature `l42-prof`).
+/// Equality ignores them, so the tests compare what they always did.
+#[derive(Clone, Debug, Default)]
+pub struct Phases {
+    /// Cycles: 0 tops (cert), 1 extend, 2 advance+list, 3 sort tops,
+    /// 4 scan incl. survivors, 5 survivor calls (all), 6 full check,
+    /// 7 prefilter (incl. in-field test).
+    pub cyc: [u64; 8],
+    /// Top-layer prefixes visited (in range), cert calls that passed, tops.
+    pub layer: u64,
+    pub cert_some: u64,
+    pub clipped: u64,
+    /// Bottoms extended (kept by extend), listed (sum over keys), ANDs.
+    pub ext: u64,
+    pub listed: u64,
+    pub ands: u64,
+    /// AND passes, of them outside the top's residue range.
+    pub and_pass: u64,
+    pub out_of_range: u64,
+    /// Keys with tops (lists built).
+    pub keys: u64,
+}
+
+impl PartialEq for Phases {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+impl Eq for Phases {}
+
+impl Phases {
+    pub fn add(&mut self, o: &Phases) {
+        for i in 0..8 {
+            self.cyc[i] += o.cyc[i];
+        }
+        self.layer += o.layer;
+        self.cert_some += o.cert_some;
+        self.clipped += o.clipped;
+        self.ext += o.ext;
+        self.listed += o.listed;
+        self.ands += o.ands;
+        self.and_pass += o.and_pass;
+        self.out_of_range += o.out_of_range;
+        self.keys += o.keys;
+    }
+}
+
+#[cfg(feature = "l42-prof")]
+#[inline(always)]
+fn tsc() -> u64 {
+    // SAFETY: rdtsc has no preconditions on x86_64.
+    unsafe { core::arch::x86_64::_rdtsc() }
+}
+#[cfg(not(feature = "l42-prof"))]
+#[inline(always)]
+fn tsc() -> u64 {
+    0
+}
+/// Per-survivor timer: only with `l42-prof-surv` (it costs ~10% at b60).
+#[cfg(feature = "l42-prof-surv")]
+#[inline(always)]
+fn tsc_s() -> u64 {
+    tsc()
+}
+#[cfg(not(feature = "l42-prof-surv"))]
+#[inline(always)]
+fn tsc_s() -> u64 {
+    0
+}
+
 /// What one partition through the join found and did.
 #[derive(Clone, Debug, Default, PartialEq, Eq)]
