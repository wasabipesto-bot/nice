+        let conv = |x: W4| {
+            if self.df_seed {
+                to_digits_df(base, x, self.mg)
+            } else {
+                to_digits(base, x)
+            }
+        };
+        TopFd {
+            p,
+            sq: conv(p2),
+            ds: conv(ds),
+            cu: conv(p3),
+            dc: conv(dc),
+            ddc: conv(ddc),
+            d2,
+            d3,
+            dd3,
+        }
+    }
+
+    /// `P → P + h`: five digit-array adds and three binary adds.
+    #[inline]
+    pub fn step(&self, st: &mut TopFd) {
+        let bias = self.bias;
+        add_arr(&mut st.sq, &st.ds, self.n2, bias);
+        add_arr(&mut st.ds, &self.k_dds, self.n2, bias);
+        add_arr(&mut st.cu, &st.dc, self.n3, bias);
+        add_arr(&mut st.dc, &st.ddc, self.n3, bias);
+        add_arr(&mut st.ddc, &self.k_dddc, self.n3, bias);
+        st.d2 = st.d2.add(&self.c2);
+        st.d3 = st.d3.add(&st.dd3);
+        st.dd3 = st.dd3.add(&self.c3);
+        st.p += self.h;
+    }
+
+    /// `x mod b^k` for the digit array `x` (`k <= 48`).
+    #[inline(always)]
+    fn low_value(&self, x: &[u64; NW], k: u32) -> W4 {
+        let b = u64::from(self.b);
+        let mut acc = W4::default();
+        let full = (k / 8) as usize;
+        let part = k % 8;
+        // Top word first (partial), then down.
+        let mut started = false;
+        if part > 0 {
+            let wv = x[full] & ((1u64 << (8 * part)) - 1);
+            acc = w4(u128::from(word_value(wv, b, self.b2, self.b4)));
+            started = true;
+        }
+        for i in (0..full).rev() {
+            let wv = u128::from(word_value(x[i], b, self.b2, self.b4));
+            acc = if started {
+                acc.mul_u128(self.b8).add(&w4(wv))
+            } else {
+                w4(wv)
+            };
+            started = true;
+        }
+        acc
+    }
+
+    /// `(a^j mod b^c0) + d >= b^c0` decided in f64 from the top two digits
+    /// of `R = P^j mod b^(c0 − z)` and `d / b^(c0 − 2)`, when the margin is
+    /// clear; `None` sends it to the exact remainder (about `1/b²` of
+    /// calls). `R / b^(k−2)` lies in `[r, r + 1)` for `r` its top two digits,
+    /// and the f64 value of `d / b^(c0 − 2)` (below `b²`) is within 1e-12 of
+    /// the true one.
+    #[inline(always)]
+    fn carry_screen(&self, x: &[u64; NW], d: &W4, c0: u32, z: u32) -> Option<bool> {
+        if !self.fast_carry || c0 < z + 2 || c0 as usize >= 64 {
+            return None;
+        }
+        let k = c0 - z;
+        let r = f64::from(digit(x, k - 1)) * f64::from(self.b) + f64::from(digit(x, k - 2));
+        let df = w4_f64(d) * self.inv_pow2[c0 as usize];
+        let eps = 1e-9;
+        if r + df >= self.b2f + eps {
+            Some(true)
+        } else if r + 1.0 + df <= self.b2f - eps {
+            Some(false)
+        } else {
+            None
+        }
+    }
+
+    /// The certificate of the block of `st.p` (unclipped): `Base::cert(a,
+    /// a + w − 1, cap)`.
+    #[must_use]
+    #[inline]
+    pub fn cert(&self, base: &Base, st: &TopFd) -> Option<u64> {
+        let top = (self.b - 1) as u8;
+        let mut mask = 0u64;
+        let mut doms = [0u64; 2];
+        let pows = [
+            (&st.sq, &st.d2, self.s2, 2 * self.f0),
+            (&st.cu, &st.d3, self.s3, 3 * self.f0),
+        ];
+        for (dom, (x, d, sp, z)) in doms.iter_mut().zip(pows) {
+            let c0 = self.cap.max(self.ndig(base, d));
+            if c0 >= sp {
+                continue;
+            }
+            let at = |pos: u32| if pos < z { 0 } else { digit(x, pos - z) };
+            let one_more = match self.carry_screen(x, d, c0, z) {
+                Some(v) => v,
+                None => {
+                    let rem = if c0 > z {
+                        self.low_value(x, c0 - z).mul_u128(base.powu(z))
+                    } else {
+                        W4::default()
+                    };
+                    !rem.add(d).lt(&base.poww[c0 as usize])
+                }
+            };
+            let mut pos = c0;
+            if one_more {
+                while at(pos) == top {
+                    pos += 1;
+                }
+                let g = at(pos);
+                *dom = digit_range_mask(g, g + 1);
+                pos += 1;
+            }
+            while pos < sp {
+                let bit = 1u64 << at(pos);
+                if mask & bit != 0 {
+                    return None;
+                }
+                mask |= bit;
+                pos += 1;
+            }
+        }
+        close_certificate(mask, doms)
+    }
+}
