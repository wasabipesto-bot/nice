+//! L42 scratch (not for a PR): the CPU top certificate stepped by finite
+//! differences across consecutive top prefixes `P, P + h, P + 2h, ...`
+//! (`h = b^s`), for timing and exactness against `Base::cert`.
+//!
+//! An unclipped block is `[a, a + w − 1]` with `a = P·w`, `w = b^f0`, so
+//! `a^j = P^j · b^(j·f0)`: the digits of `a²`, `a³` are those of `P²`, `P³`
+//! shifted up. The state keeps `P²`, `P³` and their differences in step `h`
+//! as packed base-b digits (8 a word, biased add as in `detailed_fd`), and
+//! `d_j = e^j − a^j` with its differences in binary.
+#![allow(
+    clippy::pedantic,
+    clippy::many_single_char_names,
+    clippy::cast_possible_truncation,
+    clippy::needless_range_loop,
+    missing_docs
+)]
+
+use crate::overlap_join::{Base, DIGIT_BUF, W4, close_certificate, digit_range_mask};
+
+/// Words per digit array (48 digits).
+const NW: usize = 6;
+const LO: u64 = 0x0101_0101_0101_0101;
+
+#[inline(always)]
+fn add_word(a: u64, r: u64, cin: bool, bias: u64) -> (u64, bool) {
+    let rb = r + bias * LO;
+    let (t, c1) = a.overflowing_add(rb);
+    let (t, c2) = t.overflowing_add(u64::from(cin));
+    let cout = c1 | c2;
+    let carried = (((t ^ a ^ rb) >> 8) & LO) | (u64::from(cout) << 56);
+    (t - (carried ^ LO) * bias, cout)
+}
+
+#[inline(always)]
+fn add_arr(a: &mut [u64; NW], r: &[u64; NW], nw: usize, bias: u64) {
+    let mut c = false;
+    for i in 0..nw {
+        let (t, co) = add_word(a[i], r[i], c, bias);
+        a[i] = t;
+        c = co;
+    }
+    debug_assert!(!c, "digit array overflow");
+}
+
+#[inline(always)]
+fn digit(a: &[u64; NW], i: u32) -> u8 {
+    (a[(i >> 3) as usize] >> ((i & 7) * 8)) as u8
+}
+
+/// The value of a word of 8 packed digits (`< b^8 <= 2^48`): three
+/// multiplies.
+#[inline(always)]
+fn word_value(w: u64, b: u64, b2: u64, b4: u64) -> u64 {
+    const M8: u64 = 0x00FF_00FF_00FF_00FF;
+    const M16: u64 = 0x0000_FFFF_0000_FFFF;
+    let x = (w & M8) + ((w >> 8) & M8) * b; // 16-bit lanes, < b^2
+    let y = (x & M16) + ((x >> 16) & M16) * b2; // 32-bit lanes, < b^4
+    (y & 0xFFFF_FFFF) + (y >> 32) * b4
+}
+
+fn to_digits(base: &Base, x: W4) -> [u64; NW] {
+    let mut buf = [0u8; DIGIT_BUF];
+    let len = base.ndig_w(&x);
+    base.digits_w(x, len, &mut buf);
+    let mut out = [0u64; NW];
+    for i in 0..len as usize {
+        out[i / 8] |= u64::from(buf[i]) << (8 * (i % 8));
+    }
+    out
+}
+
+/// [`to_digits`] without a hardware division: chunks of 8 digits by
+/// `Div64` (`b^8 <= 2^48`), each split by `b^4` and then digit by digit by a
+/// reciprocal multiply.
+fn to_digits_df(base: &Base, mut x: W4, mg: Mg) -> [u64; NW] {
+    let d8 = &base.dpow[8];
+    let d4 = &base.dpow[4];
+    let mut out = [0u64; NW];
+    let mut i = 0;
+    while x != W4::default() {
+        let chunk = d8.divrem_w4(&mut x);
+        let sh = d4.shift;
+        let u1 = if sh == 0 { 0 } else { chunk >> (64 - sh) };
+        let (hi, lo) = d4.div2by1(u1, chunk << sh);
+        let lo = lo >> sh;
+        let (mut hi, mut lo) = (hi, lo);
+        let mut word = 0u64;
+        for j in 0..4 {
+            let (q, r) = mg.divrem(lo);
+            word |= u64::from(r) << (8 * j);
+            lo = q;
+            let (q, r) = mg.divrem(hi);
+            word |= u64::from(r) << (8 * (j + 4));
+            hi = q;
+        }
+        out[i] = word;
+        i += 1;
+    }
+    out
+}
+
+fn w4(x: u128) -> W4 {
+    W4([x as u64, (x >> 64) as u64, 0, 0])
+}
+
+fn bitlen(x: &W4) -> u32 {
+    for i in (0..4).rev() {
+        if x.0[i] != 0 {
+            return 64 * i as u32 + 64 - x.0[i].leading_zeros();
+        }
+    }
+    0
+}
+
+/// Field constants for the FD certificate at one base.
+pub struct TopFdSetup {
+    b: u32,
+    bias: u64,
+    b2: u64,
+    b4: u64,
+    b8: u128,
+    f0: u32,
+    s2: u32,
+    s3: u32,
+    cap: u32,
+    w: u128,
+    delta: u128,
+    pub h: u128,
+    /// Words the square family and the cube family need.
+    n2: usize,
+    n3: usize,
+    k_dds: [u64; NW],
+    k_dddc: [u64; NW],
+    c2: W4,
+    c3: W4,
+    /// `ndig(2^(L − 1))` for bit length `L` (index `L`).
+    ndig_tab: [u8; 257],
+    /// `b^(2 − c)` as f64, and `b²`.
+    inv_pow2: [f64; 64],
+    b2f: f64,
+    /// Use the f64 carry screen (else always the exact remainder).
+    pub fast_carry: bool,
+    /// Seed without hardware division.
+    pub df_seed: bool,
+    mg: Mg,
+}
+
+const TWO64: f64 = 18_446_744_073_709_551_616.0;
+
+#[inline(always)]
+fn w4_f64(x: &W4) -> f64 {
+    let mut i = 3;
+    while i > 0 && x.0[i] == 0 {
+        i -= 1;
+    }
+    let hi = x.0[i] as f64;
+    if i == 0 {
+        return hi;
+    }
+    let lo = x.0[i - 1] as f64;
+    let sc = TWO64.powi(i as i32 - 1);
+    (hi * TWO64 + lo) * sc
+}
+
+/// The stepped state of one top prefix.
+#[derive(Clone)]
+pub struct TopFd {
+    pub p: u128,
+    sq: [u64; NW],
+    ds: [u64; NW],
+    cu: [u64; NW],
+    dc: [u64; NW],
+    ddc: [u64; NW],
+    d2: W4,
+    d3: W4,
+    dd3: W4,
+}
+
+impl TopFdSetup {
+    /// `s`: step `h = b^s` in `P`; `t`: digits of `P` (the top layer's `t`).
+    /// `None` if the arrays would not hold the field's powers.
+    #[must_use]
+    pub fn try_new(base: &Base, f0: u32, t: u32, s: u32, cap: u32) -> Option<Self> {
+        let n3 = ((3 * t + 2 * s + 2) as usize).div_ceil(8);
+        (n3 <= NW && base.b <= 64 && base.dpow.len() > 8).then(|| Self::new(base, f0, t, s, cap))
+    }
+
+    #[must_use]
+    pub fn new(base: &Base, f0: u32, t: u32, s: u32, cap: u32) -> Self {
+        let b = base.b;
+        let bu = u128::from(b);
+        let w = base.powu(f0);
+        let h = base.powu(s);
+        let hh = w * h;
+        let delta = w - 1;
+        // Square family: P², 2Ph + h², 2h²; cube family: P³, ..., 6h³.
+        let n2 = ((2 * t + s + 2) as usize).div_ceil(8);
+        let n3 = ((3 * t + 2 * s + 2) as usize).div_ceil(8);
+        assert!(n3 <= NW, "digit arrays too small");
+        let mut ndig_tab = [0u8; 257];
+        for l in 1..=256u32 {
+            let mut x = W4::default();
+            let bit = l - 1;
+            x.0[(bit / 64) as usize] = 1u64 << (bit % 64);
+            ndig_tab[l as usize] = base.ndig_w(&x) as u8;
+        }
+        Self {
+            b,
+            bias: 256 - u64::from(b),
+            b2: u64::from(b) * u64::from(b),
+            b4: u64::from(b).pow(4),
+            b8: bu.pow(8),
+            f0,
+            s2: base.s2,
+            s3: base.s3,
+            cap,
+            w,
+            delta,
+            h,
+            n2,
+            n3,
+            inv_pow2: std::array::from_fn(|c| f64::from(b).powi(2 - c as i32)),
+            b2f: f64::from(b) * f64::from(b),
+            fast_carry: true,
+            df_seed: true,
+            mg: Mg::new(u64::from(b)),
+            k_dds: to_digits(base, w4(2 * h * h)),
+            k_dddc: to_digits(base, w4(6 * h * h * h)),
+            c2: w4(2 * delta * hh),
+            c3: W4::mul_u128_u128(6 * delta * hh, hh),
+            ndig_tab,
+        }
+    }
+
+    /// `ndig(d)`: one table read and one compare.
+    #[inline(always)]
+    fn ndig(&self, base: &Base, d: &W4) -> u32 {
+        let l = bitlen(d);
+        if l == 0 {
+            return 0;
+        }
+        let c = u32::from(self.ndig_tab[l as usize]);
+        c + u32::from(!d.lt(&base.poww[c as usize]))
+    }
+
+    /// The state at `P` (exact arithmetic and divisions).
+    #[must_use]
+    pub fn seed(&self, base: &Base, p: u128) -> TopFd {
+        let h = self.h;
