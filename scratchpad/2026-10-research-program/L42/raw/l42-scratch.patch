+/// Exact `x / d` by a 48-bit reciprocal for `x < 2^48 / d` (as `cpu_join`'s
+/// `SmallDiv::divrem`).
+#[derive(Clone, Copy)]
+pub struct Mg {
+    d: u64,
+    magic: u64,
+}
+
+impl Mg {
+    #[must_use]
+    pub fn new(d: u64) -> Self {
+        Self {
+            d,
+            magic: (1u64 << 48).div_ceil(d),
+        }
+    }
+    #[inline(always)]
+    fn divrem(self, x: u64) -> (u64, u8) {
+        let q = ((u128::from(x) * u128::from(self.magic)) >> 48) as u64;
+        (q, (x - q * self.d) as u8)
+    }
+}
+
+/// `Base::cert` with its digit extraction division-free: the quotient's
+/// digits (at most 12, below `b^12`) come from one `Div64` split by `b^6`
+/// and two reciprocal-multiply chains, instead of a hardware `div` a digit.
+#[must_use]
+pub fn cert_df(base: &Base, mg: Mg, a: u128, e: u128, cap: u32) -> Option<u64> {
+    let a2 = W4::mul_u128_u128(a, a);
+    let e2 = W4::mul_u128_u128(e, e);
+    let a3 = a2.mul_u128(a);
+    let e3 = e2.mul_u128(e);
+    let top = (base.b - 1) as u8;
+    let mut mask = 0u64;
+    let mut dx = [0u8; DIGIT_BUF];
+    let mut doms = [0u64; 2];
+    for (dom, (x, y, sp)) in doms.iter_mut().zip([(a2, e2, base.s2), (a3, e3, base.s3)]) {
+        let d = y.sub(&x);
+        let c0 = cap.max(base.ndig_w(&d));
+        if c0 >= sp {
+            continue;
+        }
+        let (qx, rem) = base.shift_down_rem(x, c0);
+        let one_more = !rem.add(&d).lt(&base.poww[c0 as usize]);
+        let len = sp - c0;
+        if len <= 12 && qx.0[2] == 0 && qx.0[3] == 0 {
+            let (hi, lo) = base.dpow[6].divrem_u128(qx.to_u128());
+            let (mut hi, mut lo) = (hi as u64, lo);
+            for i in 0..6 {
+                let (q, r) = mg.divrem(lo);
+                dx[i] = r;
+                lo = q;
+                if i + 6 < len as usize {
+                    let (q, r) = mg.divrem(hi);
+                    dx[i + 6] = r;
+                    hi = q;
+                }
+            }
+        } else {
+            base.digits_w(qx, len, &mut dx);
+        }
+        let mut from = 0usize;
+        if one_more {
+            while dx[from] == top {
+                from += 1;
+            }
+            *dom = digit_range_mask(dx[from], dx[from] + 1);
+            from += 1;
+        }
+        for &digit in &dx[from..len as usize] {
+            let bit = 1u64 << digit;
+            if mask & bit != 0 {
+                return None;
+            }
+            mask |= bit;
+        }
+    }
+    close_certificate(mask, doms)
+}
