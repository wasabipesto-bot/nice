+/// Review-only (not part of the branch): where the FD kernel's carried c0
+/// must be re-formed, and what the plan gives per device.
+#[cfg(test)]
+mod review_l48 {
+    use super::top_fd_fits;
+    use crate::FieldSize;
+    use crate::join_plan::{JoinLimits, JoinPlan, plan_join};
+    use crate::overlap_join::test_fields::{FRONTIER_57, PLAN_FIELDS, WINDOWS, live_partitions};
+    use crate::overlap_join::{FieldSetup, JoinParams};
+    use malachite::natural::Natural;
+    use std::collections::HashSet;
+
+    fn ndig(x: &Natural, b: u32) -> u32 {
+        let bb = Natural::from(b);
+        let mut p = Natural::from(1u32);
+        let mut i = 0;
+        while &p <= x {
+            p *= &bb;
+            i += 1;
+        }
+        i
+    }
+
+    /// The kernel's c0 for the unclipped block of P, power k.
+    fn c0(fs: &FieldSetup, p: u128, k: u32) -> u32 {
+        let w = Natural::from(fs.w);
+        let a = Natural::from(p) * &w;
+        let e = &a + &w - Natural::from(1u32);
+        let (ak, ek) = if k == 2 {
+            (&a * &a, &e * &e)
+        } else {
+            (&a * &a * &a, &e * &e * &e)
+        };
+        let d = ek - ak;
+        let sp = if k == 2 { fs.base.s2 } else { fs.base.s3 };
+        fs.jp.k.max(ndig(&d, fs.b).min(sp))
+    }
+
+    /// Every P in (lo, hi] where the kernel's carried c0 of power k changes
+    /// from P - 1 (and P - 1's c0 is below the digit count).
+    fn transitions(fs: &FieldSetup, lo: u128, hi: u128, k: u32) -> Vec<(u128, u32, u32)> {
+        let sp = if k == 2 { fs.base.s2 } else { fs.base.s3 };
+        let (clo, chi) = (c0(fs, lo, k), c0(fs, hi, k));
+        let mut out = Vec::new();
+        if clo == chi {
+            return out;
+        }
+        let mut seen = HashSet::new();
+        for c in clo + 1..=chi {
+            // smallest P in (lo, hi] with c0 >= c
+            let (mut l, mut h) = (lo + 1, hi);
+            while l < h {
+                let m = l + (h - l) / 2;
+                if c0(fs, m, k) >= c {
+                    h = m;
+                } else {
+                    l = m + 1;
+                }
+            }
+            let prev = c0(fs, l - 1, k);
+            if prev < sp && seen.insert(l) {
+                out.push((l, prev, c0(fs, l, k)));
+            }
+        }
+        out
+    }
+
+    fn unclipped(fs: &FieldSetup, p: u128) -> bool {
+        p * fs.w >= fs.s && p * fs.w + fs.w - 1 <= fs.e - 1
+    }
+
+    /// The device test's batches (`check_top_fd`, heavy).
+    fn test_batches(fs: &FieldSetup, ms: usize) -> Vec<Vec<u32>> {
+        let n = u32::try_from(fs.nparts).unwrap();
+        let all: Vec<u32> = (0..n).collect();
+        let chunks: Vec<&[u32]> = all.chunks(ms).collect();
+        let mut batches: Vec<Vec<u32>> = Vec::new();
+        if chunks.len() <= 64 {
+            batches.extend(chunks.iter().map(|c| c.to_vec()));
+        } else {
+            for i in [0, 1, 2, chunks.len() / 2, chunks.len() - 1] {
+                batches.push(chunks[i].to_vec());
+            }
+        }
+        let live = live_partitions(fs);
+        let step = live.len().div_ceil(96).max(1);
+        let thinned: Vec<u32> = live.into_iter().step_by(step).collect();
+        batches.extend(thinned.chunks(ms).take(4).map(<[u32]>::to_vec));
+        if n >= 12 {
+            batches.push([3, 2, 4, 5, 7, 8, 9, 11].into_iter().take(ms).collect());
+        }
+        batches
+    }
+
+    fn report(label: &str, fs: &FieldSetup, ms: Option<usize>) {
+        if !top_fd_fits(fs) {
+            println!("REVIEW {label}: FD does not fit");
+            return;
+        }
+        let tl: HashSet<u128> = fs.tlay.iter().map(|t| t.0).collect();
+        let batches = ms.map(|m| test_batches(fs, m));
+        for k in [2u32, 3] {
+            let tr = transitions(fs, fs.plo, fs.phi, k);
+            let mut desc = Vec::new();
+            for &(p, from, to) in &tr {
+                let (p0, v) = (p / fs.nparts, p % fs.nparts);
+                let live = tl.contains(&p0);
+                let steps = v >= 1 && unclipped(fs, p - 1) && unclipped(fs, p);
+                let in_test = batches.as_ref().is_some_and(|bs| {
+                    bs.iter().any(|b| {
+                        b.windows(2)
+                            .any(|w| u128::from(w[0]) + 1 == v && u128::from(w[1]) == v)
+                    })
+                });
+                desc.push(format!(
+                    "P={p} c0 {from}->{to} prefix_live={live} steppable={steps} in_test_batch={in_test}"
+                ));
+            }
+            println!(
+                "REVIEW {label}: k={k} cap={} s={} c0(plo)={} c0(phi)={} transitions={} {:?}",
+                fs.jp.k,
+                if k == 2 { fs.base.s2 } else { fs.base.s3 },
+                c0(fs, fs.plo, k),
+                c0(fs, fs.phi, k),
+                tr.len(),
+                desc
+            );
+        }
+    }
+
+    const MIB: u64 = 1 << 20;
+
+    #[test]
+    #[ignore = "review only"]
+    fn review_c0_transitions() {
+        let lim3080 = JoinLimits::for_buffer(10240 * MIB / 4);
+        for &(b, s, e, t, k, p) in WINDOWS {
+            let jp = JoinParams { t, k, p };
+            let fs = FieldSetup::new(b, s, e, jp).expect("field setup");
+            let tl = JoinLimits {
+                max_binding: lim3080.max_binding,
+                budget: 4 << 30,
+            };
+            let ms = JoinPlan::new(&fs, tl, 4, 1 << 24, 1, 2 << 30).unwrap().slots;
+            report(&format!("window b{b} [{s},{e}) ms={ms}"), &fs, Some(ms));
+        }
+        let mut prod: Vec<(u32, u128, u128)> = vec![
+            (57, FRONTIER_57, 100_000_000_000_000),
+            (60, 1_366_406_074_057_412_100_454, 100_000_000_000_000),
+            (62, 7_997_740_455_941_656_911_841, 100_000_000_000_000),
+            (64, 41_242_006_262_957_161_709_568, 100_000_000_000_000),
+            (60, 1_366_406_074_057_412_100_454, 10_000_000_000_000_000),
+            (62, 7_997_740_455_941_656_911_841, 10_000_000_000_000_000),
+            (64, 41_242_006_262_957_161_709_568, 10_000_000_000_000_000),
+        ];
+        for (b, start, size) in prod.drain(..) {
+            let range = FieldSize::new(start, start + size);
+            let field = plan_join(b, &range, lim3080).expect("a join field");
+            let ms = field.plan.slots;
+            report(&format!("test b{b} {size:e} first slice ms={ms}"), &field.fs, Some(ms));
+            if field.slices.len() > 1 {
+                let last = field.slices.last().unwrap();
+                let fs = field.fs.sub_range(last.start(), last.end()).unwrap();
+                let ms = JoinPlan::for_field(&fs, lim3080).unwrap().0.slots;
+                report(&format!("test b{b} {size:e} last slice ms={ms}"), &fs, Some(ms));
+            }
+        }
+        // Whole fields run in production order (every slice, consecutive
+        // batches): transitions anywhere in the field's P range.
+        for (b, start, size) in [
+            (62u32, 7_997_740_455_941_656_911_841u128, 100_000_000_000_000_000u128),
+            (60, 1_366_406_074_057_412_100_454, 10_000_000_000_000_000),
+            (62, 7_997_740_455_941_656_911_841, 10_000_000_000_000_000),
+            (60, 1_573_714_731_429_953_349_518, 100_000_000_000_000),
+            (57, FRONTIER_57, 100_000_000_000_000),
+            (62, 7_997_740_455_941_656_911_841, 100_000_000_000_000),
+        ] {
+            let range = FieldSize::new(start, start + size);
+            let field = plan_join(b, &range, lim3080).expect("a join field");
+            // The first slice's setup with the whole field's bounds (the
+            // top layer is irrelevant here: prefix_live is not meaningful).
+            let mut fs = field.fs.clone();
+            fs.tlay.clear();
+            fs.s = start;
+            fs.e = start + size;
+            fs.plo = fs.s / fs.w;
+            fs.phi = (fs.e - 1) / fs.w;
+            println!("REVIEW whole b{b} {size:e}: {} slices, first-slice ms={}", field.slices.len(), field.plan.slots);
+            report(&format!("whole b{b} {size:e} at {start}"), &fs, None);
+        }
+        let (b, s, size) = PLAN_FIELDS[0];
+        let range = FieldSize::new(s, s + size);
+        let jp = crate::overlap_join::join_params_for(b, &range).unwrap();
+        let fs = FieldSetup::new(b, s, s + size, jp).unwrap();
+        report(&format!("whole b{b} {size:e} (full-field test)"), &fs, None);
+    }
