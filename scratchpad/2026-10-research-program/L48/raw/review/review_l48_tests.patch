+    /// The plan's slots at a survivor rate `surv` (JoinPlan::new's rule).
+    fn slots_at(fs: &FieldSetup, lim: JoinLimits, surv: usize) -> (usize, usize, usize, [usize; 4]) {
+        use crate::join_plan::Footprint;
+        let fp = Footprint::of(fs, 1 << 10);
+        let bound: u32 = if lim.budget > (1 << 30) { u32::MAX } else { 1 << 24 };
+        let list_cap = (bound as usize).min(lim.max_binding / 8).min(lim.budget / 4 / 8);
+        let list = list_cap * 8;
+        let room = lim.budget.saturating_sub(fp.fixed + list);
+        let ntl = fs.tlay.len().max(1);
+        let by = [
+            16,
+            lim.max_binding / fp.largest_per_slot().max(1),
+            room / fp.per_slot().max(1),
+            (list_cap / 2 / (surv * ntl)).max(1),
+        ];
+        let slots = by.iter().copied().min().unwrap();
+        (slots, fp.fixed + list + slots * fp.per_slot(), list_cap, by)
+    }
+
+    #[test]
+    #[ignore = "review only"]
+    #[allow(clippy::cast_precision_loss)]
+    fn review_plans_per_device() {
+        let gib = 1u64 << 30;
+        let devices: Vec<(&str, JoinLimits)> = vec![
+            ("cuda 4GB", JoinLimits::for_buffer(4 * gib / 4)),
+            ("cuda 6GB", JoinLimits::for_buffer(6 * gib / 4)),
+            ("cuda 8GB", JoinLimits::for_buffer(8 * gib / 4)),
+            ("cuda 10GB", JoinLimits::for_buffer(10 * gib / 4)),
+            ("cuda 12GB", JoinLimits::for_buffer(12 * gib / 4)),
+            ("cuda 24GB", JoinLimits::for_buffer(24 * gib / 4)),
+            ("wgpu 128MiB", JoinLimits::for_buffer(128 << 20)),
+            ("wgpu 1GiB", JoinLimits::for_buffer(gib)),
+            ("wgpu 2GiB", JoinLimits::for_buffer(2 * gib)),
+            ("wgpu 4GiB-1", JoinLimits::for_buffer(4 * gib - 1)),
+            ("wgpu 64bit-index", JoinLimits::for_buffer(u64::MAX)),
+        ];
+        let fields: Vec<(u32, u128, u128, f64)> = vec![
+            (62, 7_997_740_455_941_656_911_841, 100_000_000_000_000_000, 0.53),
+            (60, 1_366_406_074_057_412_100_454, 10_000_000_000_000_000, 0.79),
+            (62, 7_997_740_455_941_656_911_841, 10_000_000_000_000_000, 0.53),
+            (64, 41_242_006_262_957_161_709_568, 10_000_000_000_000_000, 1.0),
+            (58, 130_525_216_587_923_470_200, 10_000_000_000_000_000, 1.1),
+            (58, crate::join_plan::tests::DENSE_58, 1_000_000_000_000_000, 1.6),
+            (57, FRONTIER_57, 100_000_000_000_000, 1.6),
+        ];
+        for (dname, lim) in &devices {
+            for &(b, start, size, dens) in &fields {
+                let range = FieldSize::new(start, start + size);
+                match plan_join(b, &range, *lim) {
+                    Ok(field) => {
+                        let (s1, by1, l1, b1) = slots_at(&field.fs, *lim, 1);
+                        let (s2, by2, _, b2) = slots_at(&field.fs, *lim, 2);
+                        assert_eq!(s1, field.plan.slots, "replica of the plan");
+                        assert_eq!(by1, field.plan.bytes, "replica of the bytes");
+                        let ntl = field.fs.tlay.len();
+                        let fill1 = (s1 * ntl) as f64 * dens / l1 as f64;
+                        let fill2 = (s2 * ntl) as f64 * dens / l1 as f64;
+                        println!(
+                            "REVIEWPLAN {dname} (bind {} MiB, budget {} MiB) b{b} {size:e}: {} slices, ntl {ntl}, \
+                             base {s2} slots {} MiB (bounds {b2:?}) -> PR {s1} slots {} MiB (bounds {b1:?}); \
+                             list {l1}; fill at {dens}/prefix: {:.0}% -> {:.0}%; overflow above {:.2}/prefix",
+                            lim.max_binding >> 20,
+                            lim.budget >> 20,
+                            field.slices.len(),
+                            by2 >> 20,
+                            by1 >> 20,
+                            fill2 * 100.0,
+                            fill1 * 100.0,
+                            l1 as f64 / (s1 * ntl) as f64,
+                        );
+                    }
+                    Err(e) => println!("REVIEWPLAN {dname} b{b} {size:e}: {e:?}"),
+                }
+            }
+        }
+    }
