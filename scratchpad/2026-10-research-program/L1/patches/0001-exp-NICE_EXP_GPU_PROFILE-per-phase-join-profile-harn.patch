+/// Block until the device has run everything queued, for the profile.
+fn profile_sync<R: Runtime>(client: &ComputeClient<R>) -> Result<()> {
+    cubecl::future::block_on(client.sync()).map_err(|e| anyhow!("profile sync failed: {e:?}"))
+}
