+/// L50: the set bits of each byte as u16 indices, and their count.
+#[cfg(feature = "l50-scan2")]
+static L50_LUT: [[u16; 8]; 256] = {
+    let mut t = [[0u16; 8]; 256];
+    let mut b = 0;
+    while b < 256 {
+        let mut n = 0;
+        let mut i = 0;
+        while i < 8 {
+            if b & (1 << i) != 0 {
+                t[b][n] = i as u16;
+                n += 1;
+            }
+            i += 1;
+        }
+        b += 1;
+    }
+    t
+};
+#[cfg(feature = "l50-scan2")]
+static L50_LUT_N: [u8; 256] = {
+    let mut t = [0u8; 256];
+    let mut b = 0;
+    while b < 256 {
+        t[b] = (b as u32).count_ones() as u8;
+        b += 1;
+    }
+    t
+};
