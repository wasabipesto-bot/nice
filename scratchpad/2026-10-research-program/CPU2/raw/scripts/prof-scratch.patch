+    /// CPU2 scratch: `seed` from outside.
+    pub(crate) fn seed_pub(&self, st: &mut TopFd, p: u128) {
+        self.seed(st, p);
+    }
+
+    /// CPU2 scratch: `advance`, returning (seeds, steps).
+    pub(crate) fn advance_counted(&self, st: &mut TopFd, p: u128) -> (u64, u64) {
+        let mut n = 0;
+        if p > st.p && p - st.p <= self.reach {
+            while st.p < p {
+                self.step(st);
+                n += 1;
+            }
+            if st.p == p {
+                return (0, n);
+            }
+        }
+        self.seed(st, p);
+        (1, n)
+    }
