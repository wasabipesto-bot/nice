diff --git a/common/examples/cpu2_ab.rs b/common/examples/cpu2_ab.rs
new file mode 100644
index 00000000..6324a83a
--- /dev/null
+++ b/common/examples/cpu2_ab.rs
@@ -0,0 +1,46 @@
+//! CPU2 scratch (not for the PR): contiguous partitions of one slice on one
+//! thread, as the client's pool runs them. usage:
+//! cpu2_ab <base> <start|fFRAC> <size> <slice> <v0> <count> [counts]
+use nice_common::FieldSize;
+use nice_common::base_range::get_base_range_u128;
+use nice_common::cpu_join::{CpuJoin, PartitionResult, Scratch, slices_for};
+use std::time::Instant;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let base: u32 = a[1].parse().unwrap();
+    let size: u128 = a[3].parse::<f64>().unwrap() as u128;
+    let start: u128 = if let Some(f) = a[2].strip_prefix('f') {
+        let band = get_base_range_u128(base).unwrap().unwrap();
+        let f: f64 = f.parse().unwrap();
+        let off = (band.size() as f64 * f) as u128;
+        let s = band.start() + off / size * size;
+        s.min(band.end() - size)
+    } else {
+        a[2].parse().unwrap()
+    };
+    let si: usize = a[4].parse().unwrap();
+    let v0: u32 = a[5].parse().unwrap();
+    let count: u32 = a[6].parse().unwrap();
+    let range = FieldSize::new(start, start + size);
+    let (jp, slices) = slices_for(base, &range).expect("a join field");
+    let t = Instant::now();
+    let join = CpuJoin::new(base, &slices[si], jp).expect("setup");
+    let setup = t.elapsed().as_secs_f64();
+    let v1 = (v0 + count).min(join.partitions());
+    let mut sc = Scratch::default();
+    let mut out = PartitionResult::default();
+    let wall = Instant::now();
+    for v in v0..v1 {
+        out.add(join.run_partition(v, &mut sc));
+    }
+    let secs = wall.elapsed().as_secs_f64();
+    out.hits.sort_unstable();
+    println!(
+        "AB b{base} start {start} size {size:e} slice {si}/{} v {v0}..{v1} setup {setup:.3} secs {secs:.4} survivors {} checked {} hits {:?}",
+        slices.len(),
+        out.survivors,
+        out.checked,
+        out.hits
+    );
+}
diff --git a/common/examples/cpu2_prof.rs b/common/examples/cpu2_prof.rs
new file mode 100644
index 00000000..f6cf16ec
--- /dev/null
+++ b/common/examples/cpu2_prof.rs
@@ -0,0 +1,69 @@
+//! CPU2 scratch (not for the PR): the CPU join's top phase at production
+//! shapes. usage: cpu2_prof <base> <start|fFRAC> <size> <partitions> [slices: all|i]
+use nice_common::FieldSize;
+use nice_common::base_range::get_base_range_u128;
+use nice_common::bench_defs::sample_order;
+use nice_common::cpu_join::{CpuJoin, Scratch, slices_for};
+use std::time::Instant;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let base: u32 = a[1].parse().unwrap();
+    let size: u128 = a[3].parse::<f64>().unwrap() as u128;
+    let start: u128 = if let Some(f) = a[2].strip_prefix('f') {
+        let band = get_base_range_u128(base).unwrap().unwrap();
+        let f: f64 = f.parse().unwrap();
+        let off = (band.size() as f64 * f) as u128;
+        let s = band.start() + off / size * size;
+        s.min(band.end() - size)
+    } else {
+        a[2].parse().unwrap()
+    };
+    let want: usize = a[4].parse().unwrap();
+    let range = FieldSize::new(start, start + size);
+    let (jp, slices) = slices_for(base, &range).expect("a join field");
+    let which: Vec<usize> = match a.get(5).map(String::as_str) {
+        None | Some("all") => (0..slices.len()).collect(),
+        Some("spread") => {
+            let mut v = vec![0, slices.len() / 2, slices.len() - 1];
+            v.dedup();
+            v
+        }
+        Some(i) => vec![i.parse().unwrap()],
+    };
+    println!(
+        "FIELD b{base} start {start} size {size:e} {jp:?} slices {}",
+        slices.len()
+    );
+    for si in which {
+        let t = Instant::now();
+        let join = CpuJoin::new(base, &slices[si], jp).expect("setup");
+        let setup = t.elapsed().as_secs_f64();
+        let parts = join.partitions();
+        let order = sample_order(parts);
+        let n = want.min(order.len());
+        println!("SLICE {si} setup {setup:.3}s partitions {parts} sampled {n}");
+        let mut sc = Scratch::default();
+        for &v in &order[..n] {
+            let t = Instant::now();
+            let out = join.run_partition(v, &mut sc);
+            let total = t.elapsed().as_nanos();
+            let m: Vec<_> = (0..4).map(|m| join.prof_tops(v, m, &mut sc)).collect();
+            println!(
+                "PART b{base} s{si} v{v} total_ns {total} survivors {} checked {} | full_ns {} tops {} | adv_ns {} prefixes {} unclipped {} seeds {} steps {} | cert_ns {} tops {} | seedall_ns {}",
+                out.survivors,
+                out.checked,
+                m[0].ns,
+                m[0].tops,
+                m[1].ns,
+                m[1].prefixes,
+                m[1].unclipped,
+                m[1].seeds,
+                m[1].steps,
+                m[2].ns,
+                m[2].tops,
+                m[3].ns
+            );
+        }
+    }
+}
diff --git a/common/examples/cpu2_skipcount.rs b/common/examples/cpu2_skipcount.rs
new file mode 100644
index 00000000..bda5e827
--- /dev/null
+++ b/common/examples/cpu2_skipcount.rs
@@ -0,0 +1,50 @@
+//! CPU2 scratch: the skip walk's counts over contiguous partitions.
+//! usage: cpu2_skipcount <base> <start|fFRAC> <size> <slice> <v0> <count>
+use nice_common::FieldSize;
+use nice_common::base_range::get_base_range_u128;
+use nice_common::cpu_join::{CpuJoin, Scratch, slices_for};
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let base: u32 = a[1].parse().unwrap();
+    let size: u128 = a[3].parse::<f64>().unwrap() as u128;
+    let start: u128 = if let Some(f) = a[2].strip_prefix('f') {
+        let band = get_base_range_u128(base).unwrap().unwrap();
+        let f: f64 = f.parse().unwrap();
+        let off = (band.size() as f64 * f) as u128;
+        let s = band.start() + off / size * size;
+        s.min(band.end() - size)
+    } else {
+        a[2].parse().unwrap()
+    };
+    let si: usize = a[4].parse().unwrap();
+    let v0: u32 = a[5].parse().unwrap();
+    let count: u32 = a[6].parse().unwrap();
+    let range = FieldSize::new(start, start + size);
+    let (jp, slices) = slices_for(base, &range).expect("a join field");
+    let join = CpuJoin::new(base, &slices[si], jp).expect("setup");
+    let v1 = (v0 + count).min(join.partitions());
+    let mut sc = Scratch::default();
+    let (mut un, mut te, mut se, mut stp, mut to, mut ns) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+    for v in v0..v1 {
+        let p = join.prof_skip(v, &mut sc);
+        println!(
+            "V {v} unclipped {} tests {} seeds {} steps {} tops {} ns {}",
+            p.unclipped, p.tests, p.seeds, p.steps, p.tops, p.ns
+        );
+        un += p.unclipped;
+        te += p.tests;
+        se += p.seeds;
+        stp += p.steps;
+        to += p.tops;
+        ns += p.ns;
+    }
+    println!(
+        "SUM b{base} start {start} slice {si} v {v0}..{v1}: unclipped {un} tests {te} ({:.4}) seeds {se} ({:.4}/test) steps {stp} ({:.3}/test) tops {to} ({:.4}) ns/unclipped {:.1}",
+        te as f64 / un as f64,
+        se as f64 / te as f64,
+        stp as f64 / te as f64,
+        to as f64 / un as f64,
+        ns as f64 / un as f64
+    );
+}
